<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_margin_approval" model="ir.ui.view">
        <field name="name">sale.order.view.form.margin.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve_margin" type="object" string="Aprobar Venta" 
                        class="btn-success" invisible="state != 'waiting_approval'"
                        groups="sale_margin_approval.group_sale_margin_approver"/>
                
                <button name="action_reject_margin" type="object" string="Rechazar Venta" 
                        class="btn-danger" invisible="state != 'waiting_approval'"
                        groups="sale_margin_approval.group_sale_margin_approver"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="state != 'waiting_approval'">
                    Esta cotización está esperando aprobación gerencial: su margen
                    (<field name="margin_percent_display" class="oe_inline" digits="[16, 2]"/> %)
                    está por debajo del mínimo configurado para la empresa.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
