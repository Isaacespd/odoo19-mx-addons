<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_efos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.efos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting id="efos_setting_container" string="Validación EFOS (SAT)" help="Sincronizar y bloquear facturación a empresas listadas en el 69-B.">
                    <field name="efos_block_invoicing"/>
                    <div class="content-group">
                        <div class="mt8">
                            <field name="efos_allow_vendor_bills"/>
                            <label for="efos_allow_vendor_bills" class="o_light_label"/>
                        </div>
                        <div class="mt16">
                            <label for="efos_list_url" class="o_light_label"/>
                            <field name="efos_list_url"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
